# EZVIZ – Stream en SentinelVision (ezopen)
# Obtén el accessToken desde la consola EZVIZ Open Platform o tu backend.
# https://open.ys7.com/jssdk/ezopen/demo/token (China) o tu región.
VITE_EZVIZ_ACCESS_TOKEN=at.xxxxxxxxxxxxxxxxxxxxxxxx
VITE_EZVIZ_VERIFICATION_CODE=TU_CODIGO_6_DIGITOS
# Solo si tu cámara está en región internacional (ej. América/Europa):
# América del Norte: https://iusopen.ezvizlife.com
# América del Sur: https://isaopen.ezvizlife.com
# Europa: https://ieuopen.ezvizlife.com
# Singapore: https://isgpopen.ezvizlife.com
# India: https://iindiaopen.ezvizlife.com
# VITE_EZVIZ_DOMAIN=https://iusopen.ezvizlife.com
